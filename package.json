{
  "name": "Dashboard",
  "version": "2.0.0",
  "description": "A dashboard for common household needs.",
  "author": "Rawson Inc",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
